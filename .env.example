# Copy this file to .env and fill it in. Never commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# XAMPP defaults: user root, no password, MySQL on port 3306.
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/folio?charset=utf8mb4

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# Local AI chatbot (Ollama). Install from https://ollama.com, then run:  ollama pull deepseek-r1:7b
AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# In production use a shared store such as redis://127.0.0.1:6379 so rate limits are enforced across workers.
RATELIMIT_STORAGE_URI=memory://

# AI voice that runs on your computer (optional; without it Folio uses the browser's voice).
# See README.md, "Read aloud". Kokoro is used if set, otherwise Piper. Example on Windows:
#   KOKORO_MODEL=C:\kokoro\kokoro-v1.0.onnx
#   KOKORO_VOICES=C:\kokoro\voices-v1.0.bin
#   PIPER_BIN=piper
#   PIPER_MODEL=C:\piper\voices\en_US-lessac-medium.onnx
KOKORO_MODEL=
KOKORO_VOICES=
PIPER_BIN=
PIPER_MODEL=
